# Mẫu biến môi trường. Sao chép thành .env.local để ghi đè trên máy của bạn (không commit .env.local).
APP_ENV=production
# Frontend và API cùng domain trên Vercel nên không cần CORS. Nếu frontend ở domain khác, liệt kê ở đây.
CORS_ORIGINS=
# Tắt Swagger trên production; đặt 1 nếu muốn khách xem tài liệu API.
ENABLE_DOCS=0
